{
  "name": "iqtisodiyot-platform",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Iqtisodiyot nazariyasi — ta’lim va analitika platformasi (1-bosqich: sayt skeleti)",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "materials": "node scripts/build-materials-manifest.mjs",
    "predev": "npm run materials",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run materials",
    "build": "tsc --noEmit && vite build",
    "prebuild:single": "npm run materials",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host 127.0.0.1",
    "pretypecheck": "npm run materials",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
